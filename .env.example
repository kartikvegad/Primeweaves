# Email delivery for order requests (Resend)
# Get a free API key at https://resend.com
RESEND_API_KEY=
ORDER_TO_EMAIL=orders@yourdomain.com
ORDER_FROM_EMAIL=Primeweaves Orders <onboarding@resend.dev>

# WhatsApp number for the floating chat button (digits only, with country code)
# Also update src/lib/site.ts phoneDisplay / whatsappNumber
# NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Optional NextAuth leftovers (not required for ordering)
# AUTH_SECRET=
